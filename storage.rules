rules_version = '2';

// Uploads only via admin server actions (Admin SDK). Public read for site images only.
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{folder}/{file} {
      allow read: if folder in ['gallery', 'treatments', 'doctors', 'brand'];
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
